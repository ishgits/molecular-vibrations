# Python cache
__pycache__/
*.py[cod]
*.pyo

# Packaging / build
*.egg-info/
build/
dist/

# Test & tooling caches
.pytest_cache/
.ipynb_checkpoints/

# macOS
.DS_Store

# Virtual environments
venv/
.venv/
pyvista-env/

# IDE settings
.vscode/
.idea/

# Generated render output
test_figs/
fixcheck/
*.png
# ...but keep the committed example/reference images
!images/*.png

# Executed notebooks (large, embedded outputs)
*_executed.ipynb

# Gaussian / log files are ignored by default...
*.log
# ...but keep the committed example logs and test fixtures
!examples/logs/*.log
!tests/data/*.log
